# Public values only: every VITE_* variable is bundled into the client and readable by anyone.

# Base path of the REST API. The dev server proxies /api to the Spring Boot backend.
VITE_API_BASE_URL=/api/v1

# true: answer API calls with the in-browser mock (MSW). Defaults to true in dev, false in production builds.
VITE_USE_MOCK=true
